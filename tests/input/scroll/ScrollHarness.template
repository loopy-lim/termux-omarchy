import android.view.InputDevice;
import android.view.MotionEvent;
/*__POLICY_IMPORT__*/
public final class ScrollHarness {
    static final class CapturedPointerTransformation {
        static final int AUTO=-1,NONE=0,COUNTER_CLOCKWISE=1,UPSIDE_DOWN=2,CLOCKWISE=3;
    }
    static class InputStrategyInterface {
        int scrolls;
        void onScroll(float x,float y){scrolls++;}
        static final class TrackpadInputStrategy extends InputStrategyInterface {}
        static final class SimulatedTouchInputStrategy extends InputStrategyInterface {}
        static final class NullInputStrategy extends InputStrategyInterface {}
    }
    static final class Injector {float capturedPointerSpeedFactor=1;boolean scaleTouchpad;}
    static final class Scale {float x=1,y=1;}
    static final class RenderData {final Scale scale=new Scale();}
    static final class SwipeDetector {boolean swiping;boolean isSwiping(){return swiping;}}
    InputStrategyInterface mInputStrategy=new InputStrategyInterface.TrackpadInputStrategy();
    final Injector mInjector=new Injector();
    final RenderData mRenderData=new RenderData();
    final SwipeDetector mSwipePinchDetector=new SwipeDetector();
    int capturedPointerTransformation=0,mDisplayRotation=0;
    float mTotalMotionY,mSwipeThreshold=40;
    boolean mSuppressCursorMovement,mSwipeCompleted,mIsDragging;
    int moves,absoluteMoves,swipeActions;float lastX,lastY;
    final java.util.function.BiConsumer<Integer,Boolean> swipeDownAction=(k,d)->swipeActions++;
    final java.util.function.BiConsumer<Integer,Boolean> swipeUpAction=(k,d)->swipeActions++;
    void moveCursorByOffset(float x,float y){moves++;lastX=x;lastY=y;}
    void moveCursorToScreenPoint(float x,float y){absoluteMoves++;}
    /*__PRODUCTION_ON_SWIPE__*/
    /*__PRODUCTION_ON_SCROLL__*/
    static MotionEvent e(int count,int action,int source,int tool){return new MotionEvent(count,action,source,tool);}
    static MotionEvent pad(int count){return e(count,MotionEvent.ACTION_MOVE,InputDevice.SOURCE_TOUCHPAD,MotionEvent.TOOL_TYPE_FINGER);}
    static void check(boolean ok,String why){if(!ok)throw new AssertionError(why);}
    static int failed,passed;
    static void test(String name,Runnable body){try{body.run();passed++;System.out.println("PASS "+name);}catch(AssertionError e){failed++;System.out.println("FAIL "+name+": "+e.getMessage());}}
    public static void main(String[] args){
        test("two-finger-scroll-to-one-finger-without-down",()->{
            ScrollHarness h=new ScrollHarness();h.mSwipePinchDetector.swiping=true;
            check(h.onScroll(pad(2),pad(2),3,4),"two-finger scroll accepted");
            check(h.mInputStrategy.scrolls==1&&h.mSuppressCursorMovement,"actual scroll latches suppression");
            check(h.onScroll(pad(1),pad(1),3,4),"one-finger move must resume");
            check(h.moves==1&&!h.mSuppressCursorMovement,"actual move callback reached");
        });
        test("measured-suppressed-and-swipe-completed-state",()->{
            ScrollHarness h=new ScrollHarness();h.mSuppressCursorMovement=true;h.mSwipeCompleted=true;
            check(h.onScroll(pad(1),pad(1),3,4)&&h.moves==1,"measured state must resume");
            check(h.mSwipeCompleted,"completed swipe action remains latched");
        });
        test("repeated-one-two-one-transition",()->{
            ScrollHarness h=new ScrollHarness();h.mSwipePinchDetector.swiping=true;
            for(int i=0;i<4;i++){h.onScroll(pad(1),pad(1),3,4);h.onScroll(pad(2),pad(2),3,4);h.onScroll(pad(1),pad(1),3,4);}
            check(h.moves==8&&h.mInputStrategy.scrolls==4,"each transition resumes exactly once");
        });
        test("orientation-speed-and-scale-preserved",()->{
            ScrollHarness h=new ScrollHarness();h.mSuppressCursorMovement=true;
            h.capturedPointerTransformation=CapturedPointerTransformation.CLOCKWISE;
            h.mInjector.capturedPointerSpeedFactor=2;h.mInjector.scaleTouchpad=true;
            h.mRenderData.scale.x=2;h.mRenderData.scale.y=3;
            check(h.onScroll(pad(1),pad(1),3,4),"move accepted");
            check(h.lastX==-16&&h.lastY==18,"existing transforms preserved");
        });
        int[][] negatives={
            {0,2,0x100008,1},{2,2,0x100008,1},{3,2,0x100008,1},
            {1,0,0x100008,1},{1,1,0x100008,1},{1,3,0x100008,1},
            {1,6,0x100008,1},{1,7,0x100008,1},
            {1,2,0x1002,1},{1,2,0x10100a,1},{1,2,0x2002,3},
            {1,2,0x20004,3},{1,2,0,1},{1,2,0x100008,0},
            {1,2,0x100008,2},{1,2,0x100008,3}
        };
        for(int i=0;i<negatives.length;i++){
            final int id=i;test("ineligible-event-"+i,()->{
                int[] v=negatives[id];ScrollHarness h=new ScrollHarness();
                h.mSuppressCursorMovement=true;h.mSwipeCompleted=true;
                h.onScroll(pad(1),e(v[0],v[1],v[2],v[3]),3,4);
                check(h.mSuppressCursorMovement&&h.moves==0,"suppression must remain");
                check(h.mSwipeCompleted,"swipe-completed must remain");
            });
        }
        test("non-trackpad-strategy-preserved",()->{
            ScrollHarness h=new ScrollHarness();h.mInputStrategy=new InputStrategyInterface.SimulatedTouchInputStrategy();
            h.mSuppressCursorMovement=true;h.mSwipeCompleted=true;
            h.onScroll(pad(1),pad(1),3,4);
            check(h.mSuppressCursorMovement&&h.moves==0&&h.absoluteMoves==0,"other strategy unchanged");
        });
        test("three-finger-action-not-replayed-after-resumption",()->{
            ScrollHarness h=new ScrollHarness();h.onScroll(pad(3),pad(3),0,-50);
            check(h.swipeActions==1&&h.mSwipeCompleted&&h.mSuppressCursorMovement,"actual onSwipe latch reached");
            check(h.onScroll(pad(1),pad(1),3,4)&&h.moves==1,"physical 3-to-1 cursor resumes");
            h.onScroll(pad(3),pad(3),0,-50);
            check(h.swipeActions==1&&h.mSwipeCompleted,"same swipe action not repeated");
        });
        System.out.println("RESULT passed="+passed+" failed="+failed);
        if(failed!=0)throw new AssertionError("production onScroll regressions: "+failed);
    }
}
