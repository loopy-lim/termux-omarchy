+/* Opt-in experiment. Both exported planes must alias the exact same dma-buf.
+ * CPU-access synchronization is object-wide, so enclose both plane writes in
+ * one START/END pair. Never remove synchronization or retain borrowed mappings. */
+static int
+tva_sync_retry(int fd, struct dma_buf_sync *sync)
+{
+    int rc;
+    do { rc = ioctl(fd, DMA_BUF_IOCTL_SYNC, sync); }
+    while (rc != 0 && (errno == EINTR || errno == EAGAIN));
+    return rc;
+}
+
+/* 0: unsupported before writes; 1: success; -1: failed END after writes. */
+static int
+tva_copy_shared_planes(struct tva_codec *c, struct pipe_resource **res,
+                       const uint8_t *y, const uint8_t *uv,
+                       unsigned w, unsigned h, unsigned uv_w, unsigned uv_h,
+                       unsigned src_stride)
+{
+    if (!getenv("DMD_VA_BATCH_SYNC") || strcmp(getenv("DMD_VA_BATCH_SYNC"), "1"))
+        return false;
+    struct winsys_handle handles[2] = {{0}, {0}};
+    struct stat info[2];
+    const unsigned widths[2] = {w, uv_w}, heights[2] = {h, uv_h};
+    const uint8_t *sources[2] = {y, uv};
+    size_t row_bytes[2], spans[2];
+    int fds[2] = {-1, -1};
+    uint8_t *map = MAP_FAILED;
+    size_t map_len = 0;
+    int result = 0;
+    uint64_t start = c->copy_profile ? os_time_get_nano() : 0;
+    for (unsigned i = 0; i < 2; i++) {
+        handles[i].type = WINSYS_HANDLE_TYPE_FD;
+        if (!c->pipe->screen->resource_get_handle(c->pipe->screen, NULL, res[i],
+                &handles[i], PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE))
+            goto out;
+        fds[i] = handles[i].handle;
+        if (fds[i] < 0 || fstat(fds[i], &info[i]) != 0 || !info[i].st_ino || info[i].st_size <= 0)
+            goto out;
+        unsigned block = util_format_get_blocksize(res[i]->format);
+        if (!block || !widths[i] || !heights[i] || widths[i] > SIZE_MAX / block)
+            goto out;
+        row_bytes[i] = (size_t)widths[i] * block;
+        if (src_stride < row_bytes[i] || handles[i].stride < row_bytes[i] ||
+            (size_t)(heights[i] - 1) > (SIZE_MAX - row_bytes[i]) / handles[i].stride)
+            goto out;
+        spans[i] = (size_t)(heights[i] - 1) * handles[i].stride + row_bytes[i];
+        if (handles[i].offset > (uint64_t)info[i].st_size ||
+            spans[i] > (uint64_t)info[i].st_size - handles[i].offset)
+            goto out;
+    }
+    if (info[0].st_dev != info[1].st_dev || info[0].st_ino != info[1].st_ino ||
+        info[0].st_size != info[1].st_size || (uint64_t)info[0].st_size > SIZE_MAX)
+        goto out;
+    if (!(handles[0].offset + spans[0] <= handles[1].offset ||
+          handles[1].offset + spans[1] <= handles[0].offset))
+        goto out;
+    map_len = (size_t)info[0].st_size;
+    map = mmap(NULL, map_len, PROT_READ | PROT_WRITE, MAP_SHARED, fds[0], 0);
+    if (map == MAP_FAILED)
+        goto out;
+    struct dma_buf_sync sync = {.flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE};
+    if (tva_sync_retry(fds[0], &sync) != 0) {
+        result = -1;
+        goto out;
+    }
+    for (unsigned i = 0; i < 2; i++) {
+        uint8_t *dst = map + handles[i].offset;
+        if (handles[i].stride == row_bytes[i] && src_stride == row_bytes[i])
+            memcpy(dst, sources[i], row_bytes[i] * heights[i]);
+        else
+            for (unsigned row = 0; row < heights[i]; row++)
+                memcpy(dst + (size_t)row * handles[i].stride,
+                       sources[i] + (size_t)row * src_stride, row_bytes[i]);
+    }
+    uint64_t sync_start = c->copy_profile ? os_time_get_nano() : 0;
+    sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+    result = tva_sync_retry(fds[0], &sync) == 0 ? 1 : -1;
+    if (c->copy_profile) c->profile_batch_sync_end_ns += os_time_get_nano() - sync_start;
+out:
+    if (map != MAP_FAILED) munmap(map, map_len);
+    for (unsigned i = 0; i < 2; i++) if (fds[i] >= 0) close(fds[i]);
+    if (c->copy_profile) {
+        c->profile_batch_ns += os_time_get_nano() - start;
+        if (result > 0) c->profile_batch_ok++; else c->profile_batch_fallback++;
+    }
+    return result;
 }
 
