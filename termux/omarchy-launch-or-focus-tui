#!/bin/bash

# omarchy:summary=Launch a TUI or focus an existing terminal window for it
# omarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  COMMAND_INDEX=2
else
  APP_ID="org.omarchy.${1##*/}"
  COMMAND_INDEX=1
fi

if [[ $# -lt $COMMAND_INDEX || -z ${!COMMAND_INDEX} ]]; then
  printf '%s\n' 'Usage: omarchy-launch-or-focus-tui [--app-id=<app-id>] <command> [args...]' >&2
  exit 2
fi

# The generic focus helper evaluates a shell command, so preserve each argv item.
printf -v LAUNCH_COMMAND '%q ' omarchy-launch-tui "$@"

exec omarchy-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
