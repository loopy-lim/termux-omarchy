#!/bin/bash
# Adapted from Omarchy; Loopy PRoot launcher modifications, published 2026-10-10.

if [[ ${OMARCHY_PROOT:-0} == 1 ]]; then
  export PULSE_SERVER=unix:/run/user/1000/pulse/native
  export PULSE_COOKIE=/run/user/1000/pulse/cookie
fi

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

if [[ ${OMARCHY_PROOT:-0} == 1 ]]; then
  exec chromium \
    --no-sandbox \
    --disable-dev-shm-usage \
    --password-store=basic \
    --app="$1" "${@:2}"
fi

browser=$(xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

exec setsid uwsm-app -- $(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1) --app="$1" "${@:2}"
