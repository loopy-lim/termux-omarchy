+void Aquamarine::CWaylandOutput::announceConfigured() {
+    if (!waylandState.configured || !backend->backend->ready || !swapchain)
+        return;
+    auto held = self.lock();
+    if (!held) return;
+    if (!waylandState.announced) {
+        waylandState.announced = true;
+        backend->backend->events.newOutput.emit(SP<IOutput>(held));
+    }
+    events.state.emit(SStateEvent{.size = waylandState.configureSize});
+    needsFrame = true;
+    sched.frameReady.emit();
 }
 
