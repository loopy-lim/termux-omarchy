#!/bin/bash
# Adapted from Omarchy; Loopy PRoot launcher modifications, published 2026-10-10.

# omarchy:summary=Launch a TUI command in the default terminal with Omarchy styling
# omarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.omarchy.${1##*/}"
fi

if [[ $# -eq 0 || -z $1 ]]; then
  printf '%s\n' 'Usage: omarchy-launch-tui [--app-id=<app-id>] <command> [args...]' >&2
  exit 2
fi

if [[ ${OMARCHY_PROOT:-0} == 1 ]]; then
  exec foot "--app-id=$APP_ID" -- "$@"
fi

exec setsid uwsm-app -- xdg-terminal-exec "--app-id=$APP_ID" -e "$@"
