+void Aquamarine::CWaylandOutput::updateParentMode() {
+    if (!waylandState.configured)
+        return;
+    uint32_t refresh  = 60000;
+    bool     selected = false;
+    for (const auto& p : backend->parentOutputs) {
+        if (!p->current)
+            continue;
+        const bool entered = std::ranges::find(waylandState.parentOutputs, p->output->resource()) != waylandState.parentOutputs.end();
+        if (!entered && !(waylandState.parentOutputs.empty() && backend->parentOutputs.size() == 1))
+            continue;
+        refresh  = selected ? std::min(refresh, p->refresh) : p->refresh;
+        selected = true;
+    }
+    auto previous = preferredMode();
+    if (previous && previous->pixelSize == waylandState.configureSize && previous->refreshRate == refresh)
+        return;
+    modes = {makeShared<SOutputMode>(SOutputMode{.pixelSize = waylandState.configureSize, .refreshRate = refresh, .preferred = true})};
+    announceConfigured();
+}
